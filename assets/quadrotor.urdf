<?xml version="1.0"?>
<robot name="quadrotor">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0023" ixy="0" ixz="0" iyy="0.0023" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry><box size="0.18 0.18 0.04"/></geometry>
      <material name="body"><color rgba="0.15 0.15 0.18 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.18 0.18 0.04"/></geometry>
    </collision>
  </link>

  <link name="arm_fl">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual>
      <origin xyz="0.10 0.10 0.025"/>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
      <material name="prop"><color rgba="0.8 0.2 0.2 0.8"/></material>
    </visual>
  </link>
  <joint name="j_fl" type="fixed"><parent link="base_link"/><child link="arm_fl"/></joint>

  <link name="arm_fr">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual>
      <origin xyz="0.10 -0.10 0.025"/>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
      <material name="prop2"><color rgba="0.2 0.2 0.8 0.8"/></material>
    </visual>
  </link>
  <joint name="j_fr" type="fixed"><parent link="base_link"/><child link="arm_fr"/></joint>

  <link name="arm_bl">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual>
      <origin xyz="-0.10 0.10 0.025"/>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
      <material name="prop3"><color rgba="0.2 0.2 0.8 0.8"/></material>
    </visual>
  </link>
  <joint name="j_bl" type="fixed"><parent link="base_link"/><child link="arm_bl"/></joint>

  <link name="arm_br">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual>
      <origin xyz="-0.10 -0.10 0.025"/>
      <geometry><cylinder radius="0.04" length="0.005"/></geometry>
      <material name="prop4"><color rgba="0.8 0.2 0.2 0.8"/></material>
    </visual>
  </link>
  <joint name="j_br" type="fixed"><parent link="base_link"/><child link="arm_br"/></joint>
</robot>
